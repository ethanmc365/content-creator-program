# ============================================================
# Tryp.com Creator Platform — environment variables
# Copy this file to .env and fill in both values.
# Find them in Supabase: Project Settings → API.
# ============================================================

# Your Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Your Supabase "anon / public" API key (safe for the browser —
# row-level security is what protects the data, not this key).
VITE_SUPABASE_ANON_KEY=

# Optional. The project's own Sentry DSN is compiled in as the default (a DSN
# is public by design — see src/lib/monitoring.js), so this only needs setting
# to point a fork or a staging build at a different Sentry project.
# Monitoring is off in development regardless.
VITE_SENTRY_DSN=
